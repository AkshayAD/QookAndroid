# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-side AI proxy
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call API routes.
# Defaults include qook.in, www.qook.in, localhost:5173, and localhost:4173.
ALLOWED_ORIGINS=

# Optional override for the production Qook Google client ID used by web GIS and
# Android native sign-in. If omitted, Qook falls back to the canonical production
# client ID embedded in the live app.
VITE_GOOGLE_CLIENT_ID=

# Android should use native Google sign-in in production. Set this only for
# local debug builds if you need to force the hosted qook.in fallback route.
VITE_ANDROID_WEB_AUTH_FALLBACK=false
